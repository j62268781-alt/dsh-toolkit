diff --git a/packages/dsh_remote/test/relay_binary_test.dart b/packages/dsh_remote/test/relay_binary_test.dart
new file mode 100644
index 0000000..4c00560
--- /dev/null
+++ b/packages/dsh_remote/test/relay_binary_test.dart
@@ -0,0 +1,184 @@
+// `transport.relay.bin.v1`: once the Server echoes the capability, relay
+// ciphertext travels as raw binary WebSocket frames (25-byte header, 1.0005×)
+// instead of base64 inside JSON (1.34×) — the saving lands on the phone ⇄
+// cloud leg, which is usually the tight one.
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:dsh_remote/dsh_remote.dart';
+import 'package:test/test.dart';
+
+const _connectionId = '018f2b9a-6f2b-7c4d-9a11-8b0f5c2d3e4f';
+
+String _frame(String type, Map<String, Object?> payload) => jsonEncode({
+  'v': 1,
+  'id': 'f-$type-${payload.hashCode}',
+  'type': type,
+  'timestamp': DateTime.now().millisecondsSinceEpoch,
+  'payload': payload,
+});
+
+Map<String, Object?> _ack(List<String> capabilities) => {
+  'protocol': 1,
+  'serverVersion': 'test',
+  'connectionSessionId': 'cs1',
+  'heartbeatIntervalMs': 25000,
+  'maxControlFrameBytes': 65536,
+  'maxRelayFrameBytes': 1024 * 1024,
+  'capabilities': capabilities,
+};
+
+void main() {
+  final servers = <HttpServer>[];
+  tearDown(() async {
+    for (final server in servers) {
+      await server.close(force: true);
+    }
+    servers.clear();
+  });
+
+  test('negotiated binary Relay frames replace the base64 text form', () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    servers.add(server);
+    final textFrames = <Map<String, Object?>>[];
+    final binaryFrames = <Uint8List>[];
+    final connected = Completer<WebSocket>();
+
+    server.listen((request) async {
+      final ws = await WebSocketTransformer.upgrade(request);
+      connected.complete(ws);
+      ws.listen((raw) {
+        if (raw is! String) {
+          binaryFrames.add(raw is Uint8List ? raw : Uint8List.fromList(raw as List<int>));
+          return;
+        }
+        final frame = jsonDecode(raw) as Map<String, Object?>;
+        textFrames.add(frame);
+        switch (frame['type']) {
+          case 'hello':
+            ws.add(_frame('hello.ack', _ack(['transport.relay', relayBinaryCapability])));
+          case 'connect.request':
+            ws.add(_frame('connect.accepted', {'connectionId': _connectionId}));
+          case 'secure.handshake':
+            ws.add(
+              _frame('secure.handshake', {
+                'connectionId': _connectionId,
+                'targetDeviceId': 'phone',
+                'step': 2,
+                'data': 'AA',
+              }),
+            );
+          case 'ping':
+            ws.add(_frame('pong', {'nonce': frame['payload']}));
+        }
+      });
+    });
+
+    final transport = await RelayTransport.connect(
+      url: Uri.parse('ws://127.0.0.1:${server.port}/ws/v1/connect'),
+      deviceId: 'phone',
+      accessToken: 'token',
+      hostDeviceId: 'host',
+      timeout: const Duration(seconds: 5),
+    );
+    addTearDown(transport.close);
+
+    final handshake = Completer<void>();
+    final received = Completer<(Uint8List, int?)>();
+    transport.listen(
+      onData: (data, counter) {
+        if (!received.isCompleted) received.complete((data, counter));
+      },
+      onHandshake: (step, data) {
+        if (step == 2 && !handshake.isCompleted) handshake.complete();
+      },
+      onClosed: (reason) {
+        if (!received.isCompleted) received.completeError(StateError(reason.code));
+      },
+    );
+
+    await transport.sendHandshake(1, Uint8List.fromList([1, 2, 3]));
+    await handshake.future.timeout(const Duration(seconds: 5));
+
+    // Server → phone: the Server answers with a binary frame.
+    final inbound = Uint8List.fromList(List<int>.generate(4096, (index) => index % 251));
+    unawaited(
+      connected.future.then(
+        (ws) => ws.add(
+          encodeRelayBinaryFrame(connectionId: _connectionId, counter: 3, ciphertext: inbound),
+        ),
+      ),
+    );
+    final (data, counter) = await received.future.timeout(const Duration(seconds: 5));
+    expect(counter, 3);
+    expect(data, inbound);
+
+    // Phone → Server: ciphertext leaves as binary, not as base64 JSON.
+    final outbound = Uint8List.fromList([9, 8, 7, 6, 5]);
+    await transport.send(outbound, counter: 4);
+    await Future<void>.delayed(const Duration(milliseconds: 50));
+    expect(binaryFrames, hasLength(1));
+    final decoded = decodeRelayBinaryFrame(binaryFrames.single);
+    expect(decoded.connectionId, _connectionId);
+    expect(decoded.counter, 4);
+    expect(decoded.ciphertext, outbound);
+    expect(
+      binaryFrames.single.length,
+      relayBinaryHeaderBytes + outbound.length,
+      reason: 'a binary Relay frame carries the ciphertext verbatim',
+    );
+    expect(
+      textFrames.where((frame) => frame['type'] == 'relay'),
+      isEmpty,
+      reason: 'no base64 relay frame may follow the negotiated binary form',
+    );
+  });
+
+  test('a binary frame without negotiation is a protocol error', () async {
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    servers.add(server);
+    server.listen((request) async {
+      final ws = await WebSocketTransformer.upgrade(request);
+      ws.listen((raw) {
+        if (raw is! String) return;
+        final frame = jsonDecode(raw) as Map<String, Object?>;
+        switch (frame['type']) {
+          case 'hello':
+            ws.add(_frame('hello.ack', _ack(['transport.relay'])));
+          case 'connect.request':
+            ws.add(_frame('connect.accepted', {'connectionId': _connectionId}));
+            ws.add(
+              encodeRelayBinaryFrame(
+                connectionId: _connectionId,
+                counter: 0,
+                ciphertext: Uint8List.fromList([1]),
+              ),
+            );
+        }
+      });
+    });
+
+    final transport = await RelayTransport.connect(
+      url: Uri.parse('ws://127.0.0.1:${server.port}/ws/v1/connect'),
+      deviceId: 'phone',
+      accessToken: 'token',
+      hostDeviceId: 'host',
+      timeout: const Duration(seconds: 5),
+    );
+    addTearDown(transport.close);
+
+    final closed = Completer<RemoteTransportClosed>();
+    transport.listen(
+      onData: (_, _) {},
+      onHandshake: (_, _) {},
+      onClosed: (reason) {
+        if (!closed.isCompleted) closed.complete(reason);
+      },
+    );
+    final reason = await closed.future.timeout(const Duration(seconds: 5));
+    expect(reason.code, 'INVALID_MESSAGE');
+    expect(reason.retryable, isFalse);
+  });
+}
