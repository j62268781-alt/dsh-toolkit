+/// Capability that carries Relay ciphertext as raw binary WebSocket frames
+/// instead of base64 inside JSON (`transport.relay.bin.v1`).
+///
+/// The Relay payload is opaque ciphertext, so only the two endpoints that
+/// touch the bytes get to pick a representation: a 48 KiB secure fragment is
+/// ~65.8 KiB as a text frame (base64 plus envelope) but 48 KiB plus a 25-byte
+/// header as a binary frame. A Server that does not echo this capability keeps
+/// sending `relay` text frames exactly as before.
+const String relayBinaryCapability = 'transport.relay.bin.v1';
+
+const int relayBinaryVersion = 1;
+
+/// version(1) + connectionId(16) + counter(8, big endian).
+const int relayBinaryHeaderBytes = 1 + 16 + 8;
+
+final RegExp _relayBinaryUuid = RegExp(
+  r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$',
+  caseSensitive: false,
+);
+
+/// Encodes one Relay frame for a Server that echoed [relayBinaryCapability].
+Uint8List encodeRelayBinaryFrame({
+  required String connectionId,
+  required int counter,
+  required Uint8List ciphertext,
+}) {
+  if (!_relayBinaryUuid.hasMatch(connectionId)) {
+    throw const ProtocolError('Relay connectionId is not a UUID.');
+  }
+  if (counter < 0 || counter > maxSafeInteger) {
+    throw const ProtocolError('Relay counter is out of range.');
+  }
+  final out = Uint8List(relayBinaryHeaderBytes + ciphertext.length);
+  out[0] = relayBinaryVersion;
+  final hex = connectionId.replaceAll('-', '');
+  for (var index = 0; index < 16; index += 1) {
+    out[1 + index] = int.parse(hex.substring(index * 2, index * 2 + 2), radix: 16);
+  }
+  var remaining = counter;
+  for (var index = 7; index >= 0; index -= 1) {
+    out[17 + index] = remaining % 256;
+    remaining ~/= 256;
+  }
+  out.setRange(relayBinaryHeaderBytes, out.length, ciphertext);
+  return out;
+}
+
+/// Decodes one Relay binary frame; any malformed header is a [ProtocolError].
+({String connectionId, int counter, Uint8List ciphertext}) decodeRelayBinaryFrame(Uint8List data) {
+  if (data.length <= relayBinaryHeaderBytes) {
+    throw const ProtocolError('Relay binary frame is too short.');
+  }
+  if (data[0] != relayBinaryVersion) {
+    throw const ProtocolError('Unsupported Relay binary frame version.');
+  }
+  final hex = StringBuffer();
+  for (var index = 1; index < 17; index += 1) {
+    hex.write(data[index].toRadixString(16).padLeft(2, '0'));
+  }
+  final raw = hex.toString();
+  final connectionId = '${raw.substring(0, 8)}-${raw.substring(8, 12)}-${raw.substring(12, 16)}'
+      '-${raw.substring(16, 20)}-${raw.substring(20)}';
+  var counter = 0;
+  for (var index = 17; index < 25; index += 1) {
+    counter = counter * 256 + data[index];
+  }
+  if (counter > maxSafeInteger) throw const ProtocolError('Relay counter is out of range.');
+  return (
+    connectionId: connectionId,
+    counter: counter,
+    ciphertext: Uint8List.sublistView(data, relayBinaryHeaderBytes),
+  );
+}
