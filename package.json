{
  "name": "dsh-toolkit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 综合插件工具箱：启动画面、桌面主题、归档聊天、浏览器自动化、结构化决策、移动设备面板、Skills/MCP 管理、会话通知与 token 用量/成本/CPU 统计。",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./contract": "./lib/modules/judgment/host/contract/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.5",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/build.mjs && tsc --noEmit && node scripts/check.mjs && node scripts/test.mjs && node scripts/build.mjs --check"
  },
  "files": [
    "index.js",
    "lib",
    "!lib/modules/*/client.js",
    "!lib/.build-manifest.json",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
