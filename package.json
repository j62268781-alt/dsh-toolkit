{
  "name": "dsh-toolkit",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH 工具箱聚合包：独立管理启动画面、主题、归档、浏览器、决策、移动设备、Skills/MCP、通知与桌面宠物。",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./contract": "./contract.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.5",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/build.mjs && tsc --noEmit && node scripts/check.mjs && node scripts/test.mjs && node scripts/build.mjs --check",
    "build:packages": "node scripts/build-packages.mjs",
    "migrate:config": "node scripts/migrate-config.mjs"
  },
  "files": [
    "index.js",
    "contract.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
