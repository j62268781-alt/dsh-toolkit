{
  "name": "dsh-toolkit-chat-scroll",
  "version": "0.2.0",
  "type": "module",
  "description": "减少长会话滚动时挂载的聊天内容，降低渲染进程的内存占用。",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat"]
    }
  },
  "files": ["index.js", "lib", "cordis.patch.yml", "README.md", "LICENSE"]
}
