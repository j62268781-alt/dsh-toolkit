{
  "name": "dsh-toolkit-git-task-monitor",
  "version": "0.2.0",
  "type": "module",
  "description": "一次安装 Git 约定与任务监控，保留两个可独立配置的组件。",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ]
}
