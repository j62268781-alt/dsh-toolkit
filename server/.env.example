DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=replace-with-a-long-random-password
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
# Must match the browser origin (scheme, hostname, port); use your HTTPS domain behind a proxy.
DSH_SERVER_PUBLIC_URL=http://localhost:8080
DSH_SERVER_DATA_FILE=./data/state.json

# Optional: comma-separated trusted reverse-proxy peer IPs. Leave empty (default)
# to disable, so X-Forwarded-For is always ignored and limits use the socket peer.
# Only bare IPv4/IPv6 literals are accepted: ports, CIDR ranges and hostnames
# make the Server fail at startup. In Docker use the proxy container/gateway IP
# as seen from the Server container, not 127.0.0.1 (which is the Server itself).
# The proxy must overwrite X-Forwarded-For with one IP, and the backend must not
# be reachable directly from the public internet.
DSH_SERVER_TRUSTED_PROXY_IPS=

# Optional: WebSocket hello handshake timeout in milliseconds (1000-60000, default: 5000).
# Values outside the allowed range are ignored with a warning and replaced by the default.
# Mobile clients on cellular networks need headroom here (TLS/relay setup + auth read),
# otherwise a cold start is closed with HELLO_TIMEOUT before the handshake finishes.
DSH_SERVER_HELLO_TIMEOUT_MS=12000

# Optional: WebSocket control channel heartbeat interval in milliseconds (5000-120000, default: 25000).
# Also keeps NAT/reverse-proxy bindings alive; 30000 stays well below any LB idle timeout.
DSH_SERVER_HEARTBEAT_INTERVAL_MS=30000

# Optional: WebSocket heartbeat disconnection threshold in milliseconds
# (default: max(75000, 3 x interval), max: 600000; must be >= 2 x HEARTBEAT_INTERVAL_MS).
# 180000 tolerates ~5 missed rounds, so a phone that briefly loses radio or is frozen by
# Doze does not start a full reconnect every time. Lower it if you need faster detection.
DSH_SERVER_HEARTBEAT_DISCONNECT_MS=180000

# Optional: control frames per second and per connection before RATE_LIMITED (64-65536, default: 512).
# RATE_LIMITED closes the socket (4001), so a busy agent streaming output can look like a
# dropped network: raise this before blaming the link.
DSH_SERVER_MAX_FRAMES_PER_SEC=2048

# Optional: bytes allowed to queue in one peer's socket before it is dropped as SLOW_CONSUMER
# (1048576-67108864, default: 16777216 = 16 MiB). Frames are up to 1 MiB, so a brief stall on a
# cellular downlink used to hit the old fixed 4 MiB in seconds and force a reconnect. Memory
# cost is this limit per connection in the worst case, which is why 64 MiB is the ceiling.
DSH_SERVER_SLOW_CONSUMER_BYTES=16777216

# Optional: grace period in milliseconds before a half-closed WebSocket is force-terminated
# (100-10000, default: 1000). Only raise this if slow clients need longer to finish the close handshake.
DSH_SERVER_FORCE_TERMINATE_GRACE_MS=1000

# Optional: structured logging level ('debug' | 'info' | 'warn' | 'error' | 'silent', default: 'info').
DSH_SERVER_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# ICE (STUN/TURN) for WebRTC — decides whether Host/Client talk directly or
# every frame goes through this Server as Relay.
# ---------------------------------------------------------------------------
# The Client ships no built-in ICE servers: with an empty list it only gathers
# host candidates, so same-LAN sessions still connect directly but any
# cross-network session (phone on 4G/5G) fails fast (4 s) and falls back to
# Relay. Adding STUN alone is enough to attempt P2P hole punching; TURN is only
# needed when both sides sit behind symmetric NAT.
#
# Public STUN that answered a binding request from a mainland-China broadband
# line on 2026-11-15 (measured 29-242 ms). Third-party, no SLA — public STUN
# servers do disappear (stun.cdnbye.com stopped answering), so re-test and drop
# dead entries; removing this line restores host-candidate + Relay behavior.
#   stun:stun.hitv.com:3478              Mango TV (hitv.com), 29-242 ms, rate limited
#   stun:stun.chat.bilibili.com:3478     Bilibili, 40-76 ms
#   stun:stun.miwifi.com:3478            Xiaomi routers, 66-104 ms
#   stun:stun.douyucdn.cn:18000          Douyu, 152 ms (port 3478 is closed)
# Do not bother with: stun.l.google.com:19302, stun.qq.com:3478,
#   stun.douyucdn.cn:3478, stun.cdnbye.com:3478, openrelay.metered.ca
#   (the free Open Relay Project now resolves to 192.0.2.1 and is gone).
DSH_SERVER_STUN_URLS=stun:stun.hitv.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.miwifi.com:3478,stun:stun.douyucdn.cn:18000

# Transports advertised to peers: lan,p2p,turn,relay. `relay` is always kept.
# Drop p2p/turn when phones cannot use them (e.g. carrier CGNAT and no working
# TURN): Clients then skip ICE and go straight to the Relay, instead of burning
# two 12s WebRTC deadlines per connection attempt. Keep `lan` so same-Wi-Fi
# sessions still connect directly. Applies to new connections only.
#   DSH_SERVER_TRANSPORTS=lan,relay
DSH_SERVER_TRANSPORTS=lan,p2p,turn,relay

# TURN is enabled only when TURN_URLS is set together with exactly one credential
# source; a partial configuration aborts startup instead of advertising TURN the
# Server cannot serve. Two mutually exclusive modes:
#   A) coturn REST API (recommended): TURN_SECRET must equal coturn's
#      static-auth-secret. The Server signs short-lived <expiryUnix>:<deviceId>
#      credentials (TTL below) and never exposes the secret. See deploy/coturn.conf.
#   B) Static pair, for TURN services that cannot use a shared secret (commercial
#      providers with a fixed username/password).
# Always advertise a TCP/turns: URL as well: some Chinese carriers rate-limit or
# drop UDP/3478, and Clients can only use what the Server hands out.
#   DSH_SERVER_TURN_URLS=turn:coturn.example.com:3478?transport=udp,turn:coturn.example.com:3478?transport=tcp,turns:coturn.example.com:5349
#   DSH_SERVER_TURN_SECRET=replace-with-the-coturn-static-auth-secret
#   DSH_SERVER_TURN_USERNAME=remote
#   DSH_SERVER_TURN_PASSWORD=replace-with-a-long-random-password
DSH_SERVER_TURN_URLS=
DSH_SERVER_TURN_SECRET=
DSH_SERVER_TURN_USERNAME=
DSH_SERVER_TURN_PASSWORD=
# TURN credential lifetime in seconds (60-3600, default 300; short-lived only).
DSH_SERVER_TURN_TTL_SECONDS=300
