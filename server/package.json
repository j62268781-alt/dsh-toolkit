{
  "name": "dsh-toolkit-server",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "description": "Self-hosted single-account Remote Server (vendored from liguobao/ds-harness-remote, MIT) with device-pairing v1",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ]
}
