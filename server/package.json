{
  "name": "dsh-toolkit-server",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Self-hosted single-account Remote Server (vendored from liguobao/ds-harness-remote, MIT) with device-pairing v1",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
