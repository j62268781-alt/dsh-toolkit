# /etc/dsh-toolkit-server.env —— 由 systemd 的 EnvironmentFile 读取。
# 权限必须是 0600（里面有账号密码）；格式为 KEY=VALUE，不要写 export、不要加引号。
#   sudo install -m 0600 deploy/env.example /etc/dsh-toolkit-server.env

# 必填：单账号模型的账号标识（例如邮箱）与密码（至少 12 个字符）。
DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=replace-with-a-long-random-password

# 必填（推荐）：手机/桌面实际访问的 origin，必须与浏览器地址完全一致（含 scheme 与端口）。
# 反代场景填公网地址，例如 https://remote.example.com；不要带路径，也不要填 127.0.0.1。
DSH_SERVER_PUBLIC_URL=https://remote.example.com

# 只监听本机，由同机的 Caddy/Nginx 对外提供 HTTPS。
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080

# 状态文件：设备、token 摘要、账号校验值。权限 0600，目录 0700。
# 必须落在 systemd 单元 ReadWritePaths 声明的目录里。
DSH_SERVER_DATA_FILE=/var/lib/dsh-toolkit-server/state.json
# Optional: override the built management UI directory (default: dist/public).
DSH_SERVER_WEB_ROOT=

# 可信反向代理：Caddy/Nginx 与 Server 同机时是 127.0.0.1（IPv6 用 ::1）。
# 只接受裸 IP 字面量、逗号分隔；非空时代理必须用**单个** X-Forwarded-For 覆盖原值。
DSH_SERVER_TRUSTED_PROXY_IPS=127.0.0.1

# 可选：日志级别 debug / info / warn / error / silent。
DSH_SERVER_LOG_LEVEL=info

# ── 长连接存活参数（手机移动网络建议就用下面这组）───────────────────────────
# hello 握手超时（毫秒，1000-60000，默认 5000）。冷启动要跑 TLS/中继 + 鉴权读盘，
# 手机弱网 5 秒容易踩线，超时会被直接关成 HELLO_TIMEOUT。
DSH_SERVER_HELLO_TIMEOUT_MS=12000

# 心跳间隔（毫秒，5000-120000，默认 25000）。同时兼任 NAT/反代保活，
# 30000 远低于任何云负载均衡的空闲超时，别调到比 LB 空闲超时还大。
DSH_SERVER_HEARTBEAT_INTERVAL_MS=30000

# 断连阈值（毫秒，默认 max(75000, 3×间隔)，上限 600000，且必须 >= 2×间隔）。
# 180000 约等于容忍 5 轮丢包：手机短暂掉信号或被 Doze 冻结不会立刻全量重连。
DSH_SERVER_HEARTBEAT_DISCONNECT_MS=180000

# 每连接每秒控制帧上限（64-65536，默认 512）。超了会 RATE_LIMITED 并**关闭连接**（4001），
# agent 大量输出时很容易被误判成「网络断了」。
DSH_SERVER_MAX_FRAMES_PER_SEC=2048

# 单连接发送积压上限（字节，1048576-67108864，默认 16777216 = 16 MiB）。
# 单帧最大 1 MiB，手机下行短暂卡顿以前会在几秒内堆满写死的 4 MiB 而被判 SLOW_CONSUMER；
# 最坏内存约等于「该值 × 同时连接数」，所以上限只到 64 MiB。
DSH_SERVER_SLOW_CONSUMER_BYTES=16777216

# 可选：WebRTC 打洞（决定手机/桌面是直连还是全程经本机 Relay）。
# 客户端没有内置 ICE 服务器：留空时只能收集 host candidate，同局域网仍是直连，
# 但手机流量等跨网场景会在约 4 秒内失败并回落 Relay。
# 只配 STUN 就能尝试 P2P 打洞（几乎不耗带宽）；不提供 TURN，国内移动网络（CGNAT）
# 通常打不通，属于预期。
#
# 以下公共 STUN 是 2026-11-15 从国内宽带上实测应答的（29-242ms），第三方无 SLA，
# 会失效（stun.cdnbye.com 已经不响应了），失效就删掉对应条目：
#   stun:stun.hitv.com:3478            芒果TV，29-242ms，有按源 IP 的限速
#   stun:stun.chat.bilibili.com:3478   B站，40-76ms
#   stun:stun.miwifi.com:3478          小米路由器，66-104ms
#   stun:stun.douyucdn.cn:18000        斗鱼，152ms（注意端口 18000，3478 不通）
# 别用：stun.l.google.com:19302、stun.qq.com:3478、stun.cdnbye.com:3478、
#       openrelay.metered.ca（免费 Open Relay 已停服，DNS 指向 192.0.2.1）。
DSH_SERVER_STUN_URLS=stun:stun.hitv.com:3478,stun:stun.chat.bilibili.com:3478,stun:stun.miwifi.com:3478,stun:stun.douyucdn.cn:18000

# 对外宣告的传输方式（逗号分隔，relay 始终保留）。默认 lan,relay：
# 同 Wi-Fi 直连、其余一律走 Relay。p2p 需要打洞，国内移动网络多为 CGNAT + IPv4，
# 打不通时要白等 12 秒才回落，所以默认不开；两端都有公网地址（例如都有公网 IPv6）
# 时可改成 DSH_SERVER_TRANSPORTS=lan,p2p,relay 再试。
DSH_SERVER_TRANSPORTS=lan,relay
