# /etc/dsh-toolkit-server.env —— 由 systemd 的 EnvironmentFile 读取。
# 权限必须是 0600（里面有账号密码）；格式为 KEY=VALUE，不要写 export、不要加引号。
#   sudo install -m 0600 deploy/env.example /etc/dsh-toolkit-server.env

# 必填：单账号模型的账号标识（例如邮箱）与密码（至少 12 个字符）。
DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=replace-with-a-long-random-password

# 必填（推荐）：手机/桌面实际访问的 origin，必须与浏览器地址完全一致（含 scheme 与端口）。
# 反代场景填公网地址，例如 https://remote.example.com；不要带路径，也不要填 127.0.0.1。
DSH_SERVER_PUBLIC_URL=https://remote.example.com

# 只监听本机，由同机的 Caddy/Nginx 对外提供 HTTPS。
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080

# 状态文件：设备、token 摘要、账号校验值。权限 0600，目录 0700。
# 必须落在 systemd 单元 ReadWritePaths 声明的目录里。
DSH_SERVER_DATA_FILE=/var/lib/dsh-toolkit-server/state.json

# 可信反向代理：Caddy/Nginx 与 Server 同机时是 127.0.0.1（IPv6 用 ::1）。
# 只接受裸 IP 字面量、逗号分隔；非空时代理必须用**单个** X-Forwarded-For 覆盖原值。
DSH_SERVER_TRUSTED_PROXY_IPS=127.0.0.1

# 可选：日志级别 debug / info / warn / error / silent。
DSH_SERVER_LOG_LEVEL=info

# 可选：WebRTC 打洞。留空则只走 Relay；配了 TURN 时客户端打洞失败会自动回落 Relay。
# DSH_SERVER_STUN_URLS=stun:turn.example.com:3478
# DSH_SERVER_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# 与 coturn 的 static-auth-secret 一致（推荐，Server 只签发短期凭据，secret 不外泄）：
# DSH_SERVER_TURN_SECRET=replace-with-the-coturn-static-auth-secret
# 或者静态账号（与 SECRET 二选一，不能同时设置）：
# DSH_SERVER_TURN_USERNAME=remote
# DSH_SERVER_TURN_PASSWORD=replace-with-a-long-random-password
# DSH_SERVER_TURN_TTL_SECONDS=300
