{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react"],
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/modules/*/client/**/*.ts",
    "src/modules/*/client/**/*.tsx"
  ]
}
